<?xml version="1.0" encoding="utf-8"?>
<!--
  The expanded view of a trip push (category TRIP_ACTIVITY): a very dark gray card
  with a tag for what it's about, an optional title line, then the body. Filled in by
  PushNotifications.kt. Only views RemoteViews can inflate are used.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/notification_card_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/notification_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/notification_tag_background"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:textColor="#E6FFFFFF"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/notification_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="#FFFFFF"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/notification_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#CCFFFFFF"
        android:textSize="15sp" />
</LinearLayout>
